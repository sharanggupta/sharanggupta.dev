{
  "name": "sharanggupta.dev",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "cv": "node scripts/generate-cv.mjs",
    "contributions": "node scripts/update-contributions.mjs",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert visual",
    "worker:dev": "wrangler -c worker/wrangler.toml dev",
    "worker:deploy": "wrangler -c worker/wrangler.toml deploy"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@playwright/test": "^1.64.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.3"
  }
}
